<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#227EDFFF">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape><corners android:radius="14dp" /><solid android:color="#183B6659" /><stroke android:width="1dp" android:color="#548BD9BE" /></shape>
            </item>
            <item android:state_focused="true">
                <shape><corners android:radius="14dp" /><solid android:color="#152F454D" /><stroke android:width="1dp" android:color="@color/mint" /></shape>
            </item>
            <item><shape><corners android:radius="14dp" /><solid android:color="#082F454D" /></shape></item>
        </selector>
    </item>
</ripple>
