<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HyperDream" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/md_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_primary_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorSurface">@color/md_background</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="StudioCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">ShapeAppearance.StudioCard</item>
    </style>
    <style name="ShapeAppearance.StudioCard" parent="">
        <item name="cornerFamily">rounded</item><item name="cornerSize">24dp</item>
    </style>
    <style name="StudioTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item><item name="android:textSize">22sp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="StudioBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item><item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item><item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="StudioButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item>
    </style>
    <style name="DurationOption" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item><item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item><item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>
    <style name="StudioSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item><item name="android:minHeight">56dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item><item name="android:textSize">15sp</item>
    </style>
</resources>
