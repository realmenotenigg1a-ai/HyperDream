<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/GlassCard">
    <TextView style="@style/GlassBody" android:background="@drawable/warning_panel" android:padding="14dp" android:text="@string/animations_not_working" android:textColor="@color/warning" android:textStyle="bold" android:accessibilityHeading="true" />
    <TextView style="@style/GlassTitle" android:text="@string/spring_title" />
    <TextView style="@style/GlassBody" android:text="@string/spring_explanation" />
    <Switch
        android:id="@+id/enable_spring"
        style="@style/DurationOption"
        android:layout_marginTop="16dp"
        android:text="@string/spring_enable" />
    <TextView
        android:id="@+id/spring_response_label"
        style="@style/GlassBody"
        android:labelFor="@id/spring_response" />
    <SeekBar
        android:id="@+id/spring_response"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:max="20"
        android:contentDescription="@string/spring_response_accessibility" />
    <TextView
        android:id="@+id/spring_damping_label"
        style="@style/GlassBody"
        android:labelFor="@id/spring_damping" />
    <SeekBar
        android:id="@+id/spring_damping"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:max="14"
        android:contentDescription="@string/spring_damping_accessibility" />
    <TextView android:id="@+id/spring_saved" style="@style/GlassBody" android:text="@string/autosave_hint" android:textColor="@color/mint" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
    <TextView style="@style/GlassBody" android:text="@string/spring_values_notice" android:textSize="13sp" />
    <Button android:id="@+id/reset_spring" style="@style/GlassButton" android:text="@string/spring_reset" />
    <TextView style="@style/GlassBody" android:text="@string/experimental_short" android:textColor="@color/warning" android:textSize="13sp" />
    <Button android:id="@+id/toggle_diagnostics" style="@style/GlassButton" android:text="@string/show_diagnostics" />
    <LinearLayout
        android:id="@+id/diagnostic_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
    <TextView style="@style/GlassBody" android:text="@string/spring_compatibility" android:textColor="@color/warning" />
    <TextView style="@style/GlassBody" android:text="@string/diagnostic_protocol" android:textSize="13sp" />
    <Button android:id="@+id/refresh_hooks" style="@style/GlassButton" android:text="@string/refresh_hooks" />
    <Button android:id="@+id/copy_hook_diagnostics" style="@style/GlassButton" android:text="@string/copy_hook_diagnostics" />
    <TextView
        android:id="@+id/hook_report"
        style="@style/GlassBody"
        android:accessibilityLiveRegion="polite"
        android:text="@string/report_none" />
    </LinearLayout>
</LinearLayout>
