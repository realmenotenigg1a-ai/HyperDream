<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/GlassCard">
    <TextView style="@style/GlassTitle" android:text="@string/fingerprint_title" />
    <TextView style="@style/GlassBody" android:text="@string/fingerprint_scope" android:textColor="@color/warning" />
    <io.github.hyperdream.module.FingerprintPreviewView
        android:id="@+id/fingerprint_preview"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/fingerprint_preview_accessibility" />
    <Button android:id="@+id/replay_fingerprint" style="@style/GlassButton" android:text="@string/fingerprint_replay" />
    <TextView style="@style/GlassBody" android:text="@string/fingerprint_choose" android:labelFor="@id/fingerprint_effects" />
    <RadioGroup android:id="@+id/fingerprint_effects" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <RadioButton android:id="@+id/fingerprint_ripple" style="@style/DurationOption" android:text="@string/fingerprint_ripple" />
        <RadioButton android:id="@+id/fingerprint_halo" style="@style/DurationOption" android:text="@string/fingerprint_halo" />
        <RadioButton android:id="@+id/fingerprint_spark" style="@style/DurationOption" android:text="@string/fingerprint_spark" />
    </RadioGroup>
    <TextView style="@style/GlassBody" android:text="@string/fingerprint_safety" android:textSize="13sp" />
</LinearLayout>
