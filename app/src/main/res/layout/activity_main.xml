<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_backdrop">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/card_stack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/GlassTitle"
                        android:text="@string/app_name"
                        android:textSize="28sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.12"
                        android:text="@string/brand_edition"
                        android:textColor="@color/mint"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-light"
                android:text="@string/glass_hero"
                android:textColor="@color/text_primary"
                android:textSize="38sp" />
            <TextView style="@style/GlassBody" android:text="@string/glass_subtitle" />

            <LinearLayout style="@style/GlassCard">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/status_pill"
                    android:text="@string/experimental_badge"
                    android:textColor="@color/mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/configuration_status"
                    style="@style/GlassBody"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/config_off"
                    android:textColor="@color/text_primary" />
                <TextView style="@style/GlassBody" android:text="@string/activation_notice" />
            </LinearLayout>

            <include layout="@layout/card_motion" />
            <include layout="@layout/card_features" />
            <include layout="@layout/card_setup" />

            <TextView
                style="@style/GlassBody"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/glass_disclaimer"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
