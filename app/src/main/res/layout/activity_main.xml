<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ScrollView
        android:id="@+id/studio_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="108dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/card_stack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:background="@drawable/logo_frame"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/StudioTitle"
                        android:text="@string/app_name"
                        android:textSize="28sp" />
                    <TextView
                        android:id="@+id/build_identity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.12"
                        android:text="@string/brand_edition"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:id="@+id/studio_heading"
                android:fontFamily="sans-serif"
                android:text="@string/glass_hero"
                android:textColor="?attr/colorOnSurface"
                android:textSize="30sp" />
            <TextView android:id="@+id/studio_caption" style="@style/StudioBody" android:text="@string/glass_subtitle" />

            <include android:id="@+id/page_spring" layout="@layout/card_spring" />
            <include android:id="@+id/page_motion" layout="@layout/card_motion" />
            <include android:id="@+id/page_fingerprints" layout="@layout/card_fingerprints" />
            <include android:id="@+id/page_setup" layout="@layout/card_setup" />
            <include android:id="@+id/page_features" layout="@layout/card_features" />

            <TextView
                style="@style/StudioBody"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/glass_disclaimer"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <io.github.hyperdream.module.StudioNavigationView
        android:id="@+id/studio_navigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="?attr/colorSurfaceContainer"
        app:menu="@menu/studio_navigation"
        app:labelVisibilityMode="labeled"
        app:itemHorizontalTranslationEnabled="false"
        android:contentDescription="@string/navigation_description" />
</FrameLayout>
