<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:id="@+id/studio_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="124dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/card_stack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:background="@drawable/logo_frame"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/GlassTitle"
                        android:text="@string/app_name"
                        android:textSize="28sp" />
                    <TextView
                        android:id="@+id/build_identity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.12"
                        android:text="@string/brand_edition"
                        android:textColor="@color/mint"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:id="@+id/studio_heading"
                android:fontFamily="sans-serif-light"
                android:text="@string/glass_hero"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />
            <TextView android:id="@+id/studio_caption" style="@style/GlassBody" android:text="@string/glass_subtitle" />

            <include android:id="@+id/page_spring" layout="@layout/card_spring" />
            <include android:id="@+id/page_motion" layout="@layout/card_motion" />
            <include android:id="@+id/page_setup" layout="@layout/card_setup" />
            <include android:id="@+id/page_features" layout="@layout/card_features" />

            <TextView
                style="@style/GlassBody"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/glass_disclaimer"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <io.github.hyperdream.module.LiquidGlassNavigationView
        android:id="@+id/glass_navigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/navigation_description" />
</FrameLayout>
