uniform shader backdrop;
uniform float2 resolution;
uniform float2 captureScale;
uniform float3 lens;
uniform float2 light;
uniform float density;

float capsule(float2 p) {
    float radius = resolution.y * 0.5;
    float2 q = p - resolution * 0.5;
    q.x -= clamp(q.x, -resolution.x * 0.5 + radius, resolution.x * 0.5 - radius);
    return length(q) - radius;
}

half3 sampleBlur(float2 p) {
    float2 uv = clamp(p, float2(0.0), resolution) * captureScale;
    float2 s = captureScale * (5.0 * density);
    half3 c = backdrop.eval(uv).rgb * 0.28;
    c += (backdrop.eval(uv + float2(s.x, 0.0)).rgb
        + backdrop.eval(uv - float2(s.x, 0.0)).rgb
        + backdrop.eval(uv + float2(0.0, s.y)).rgb
        + backdrop.eval(uv - float2(0.0, s.y)).rgb) * 0.12;
    c += (backdrop.eval(uv + s).rgb + backdrop.eval(uv - s).rgb
        + backdrop.eval(uv + float2(s.x, -s.y)).rgb
        + backdrop.eval(uv + float2(-s.x, s.y)).rgb) * 0.06;
    return c;
}

half4 main(float2 p) {
    float d = capsule(p);
    float coverage = 1.0 - smoothstep(-0.8, 0.8, d);
    if (coverage <= 0.0) return half4(0.0);

    float2 local = p - lens.xy;
    float distanceToLens = length(local);
    float relative = distanceToLens / max(lens.z, 1.0);
    float lensMask = 1.0 - smoothstep(lens.z - 0.8, lens.z + 0.8, distanceToLens);
    float2 lensNormal = local / max(distanceToLens, 0.01);
    float2 normal = normalize(float2(capsule(p + float2(0.5, 0.0)) - capsule(p - float2(0.5, 0.0)),
        capsule(p + float2(0.0, 0.5)) - capsule(p - float2(0.0, 0.5))) + float2(0.0001));
    float rim = 1.0 - smoothstep(0.0, 9.0 * density, -d);
    float lensEdge = pow(clamp(relative, 0.0, 1.0), 4.0) * lensMask;
    float2 bend = normal * rim * 6.0 * density + lensNormal * lensEdge * 9.0 * density;
    half3 color = sampleBlur(p - bend);
    // Small channel separation at curved edges, using the actual captured backdrop.
    float2 dispersion = lensNormal * lensEdge * 1.2 * density;
    color.r = sampleBlur(p - bend + dispersion).r;
    color.b = sampleBlur(p - bend - dispersion).b;
    color = mix(color, half3(0.055, 0.075, 0.095), 0.40);
    color += half3(0.025, 0.035, 0.04) * half(lensMask);

    float2 illumination = normalize(light - p + float2(0.01));
    float shine = pow(max(0.0, dot(normal, illumination)), 5.0);
    float barStroke = 1.0 - smoothstep(0.5 * density, 1.6 * density, abs(d + density));
    float ring = (1.0 - smoothstep(0.4 * density, 1.4 * density,
        abs(distanceToLens - lens.z + density))) * lensMask;
    float lensShine = pow(max(0.0, dot(lensNormal, illumination)), 5.0);
    color += half3(0.72, 0.86, 0.95) * half(barStroke * (0.12 + 0.40 * shine));
    color += half3(0.85, 0.94, 1.0) * half(ring * (0.20 + 0.55 * lensShine));
    color += half3(0.08, 0.11, 0.12) * half(lensEdge * lensShine);
    return half4(color * half(coverage), half(coverage));
}
